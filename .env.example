# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Maps / Places
# Public browser key for Maps JS and client-side Places hooks.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Server key for server actions. If omitted, server code falls back to NEXT_PUBLIC_GOOGLE_MAPS_KEY.
GOOGLE_MAPS_API_KEY=

# Gemini
GEMINI_API_KEY=

# Database: libSQL / Turso
# Local development example:
# DB_FILE_NAME=file:local.db
#
# Production Turso example:
# DB_FILE_NAME=libsql://your-database-your-org.turso.io
DB_FILE_NAME=file:local.db
# Required for remote Turso/libSQL. Leave blank for local file databases.
DB_AUTH_TOKEN=

# Mock Places data for local tests/demos.
NEXT_PUBLIC_USE_MOCK_PLACES=false
USE_MOCK_PLACES=false
